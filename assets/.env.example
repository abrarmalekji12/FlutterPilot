# Copy this file to assets/.env and fill in the values.
# (assets/.env is gitignored.)

# --- Existing keys used by the app (add yours as needed) ---
# OPENAI_SECRET_KEY=
# GEMINI_API_KEY=

# --- Google Analytics (GA4) ---
# These are ONLY used on desktop builds (Windows/macOS/Linux), where Firebase
# Analytics has no plugin and events are sent via the GA4 Measurement Protocol.
# Web/Android/iOS use Firebase Analytics directly and do not need these.
#
# GA4_MEASUREMENT_ID: the data stream measurement id, e.g. G-XXXXXXXXXX
# GA4_API_SECRET: create under GA4 Admin > Data Streams > your stream >
#                 Measurement Protocol API secrets.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
